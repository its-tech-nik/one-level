---
interface Props {
	password: string;
	storageKey?: string;
}

const { password, storageKey = 'one-level-content-auth' } = Astro.props;
---

<div class="gate" data-gate>
	<form class="gate__form" method="dialog">
		<img
			class="gate__logo"
			src="/images/logo.jpg"
			alt="One Level"
			width="96"
			height="96"
		/>
		<label class="gate__label" for="content-password">Κωδικός πρόσβασης</label>
		<input
			class="gate__input"
			id="content-password"
			name="password"
			type="password"
			autocomplete="current-password"
			required
		/>
		<p class="gate__error" data-gate-error hidden>Λάθος κωδικός. Δοκιμάστε ξανά.</p>
		<button class="btn btn--dark" type="submit">Είσοδος</button>
	</form>
</div>

<div class="gate-content" data-gate-content hidden>
	<slot />
</div>

<script define:vars={{ password, storageKey }}>
	(() => {
		const gate = document.querySelector('[data-gate]');
		const content = document.querySelector('[data-gate-content]');
		const form = gate?.querySelector('form');
		const error = gate?.querySelector('[data-gate-error]');
		const input = gate?.querySelector('input');

		if (!gate || !content || !form || !input) return;

		const unlock = () => {
			gate.hidden = true;
			content.hidden = false;
			sessionStorage.setItem(storageKey, '1');
		};

		if (sessionStorage.getItem(storageKey) === '1') {
			unlock();
			return;
		}

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			if (input.value === password) {
				if (error) error.hidden = true;
				unlock();
				return;
			}
			if (error) error.hidden = false;
			input.value = '';
			input.focus();
		});
	})();
</script>

<style>
	.gate {
		min-height: 100svh;
		display: grid;
		place-items: center;
		padding: var(--space-md);
		background:
			radial-gradient(ellipse 70% 50% at 50% 0%, rgba(26, 61, 76, 0.12), transparent 70%),
			var(--paper);
	}

	.gate[hidden] {
		display: none;
	}

	.gate__form {
		width: min(100%, 22rem);
		display: grid;
		gap: var(--space-sm);
		justify-items: stretch;
	}

	.gate__logo {
		width: 4.5rem;
		height: 4.5rem;
		object-fit: cover;
		justify-self: center;
		margin-bottom: var(--space-xs);
	}

	.gate__label {
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 520;
		color: var(--aegean-deep);
	}

	.gate__input {
		width: 100%;
		padding: 0.85rem 1rem;
		border: 1px solid var(--line-strong);
		border-radius: 0;
		background: var(--chalk);
		color: var(--graphite);
	}

	.gate__input:focus {
		outline: 2px solid var(--aegean);
		outline-offset: 2px;
	}

	.gate__error {
		color: #8a2f2f;
		font-size: 0.9rem;
	}

	.gate__form .btn {
		margin-top: var(--space-xs);
		justify-self: start;
	}
</style>
