---
const projects = [
	{
		title: 'Χώρος υποδοχής ξενοδοχείου',
		tag: 'Ανακαίνιση ξενοδοχείου',
		image: '/images/gallery-1.jpg',
		alt: 'Ανακαινισμένος χώρος υποδοχής ξενοδοχείου',
		span: 'wide',
	},
	{
		title: 'Γραφεία εταιρείας',
		tag: 'Επαγγελματικός χώρος',
		image: '/images/gallery-2.jpg',
		alt: 'Ανακαινισμένοι χώροι γραφείων',
		span: 'tall',
	},
	{
		title: 'Ξηρά δόμηση ορόφου',
		tag: 'Ξηρά δόμηση',
		image: '/images/gallery-3.jpg',
		alt: 'Εργασίες ξηράς δόμησης σε όροφο κτιρίου',
		span: 'normal',
	},
	{
		title: 'Δημόσιο κτίριο',
		tag: 'Δημόσιο έργο',
		image: '/images/gallery-4.jpg',
		alt: 'Πρόσοψη δημόσιου κτιρίου μετά από εργασίες',
		span: 'normal',
	},
	{
		title: 'Βαμμένες επιφάνειες',
		tag: 'Ελαιοχρωματισμοί',
		image: '/images/painting.jpg',
		alt: 'Ομοιόμορφες βαμμένες επιφάνειες',
		span: 'wide',
	},
];
---

<section class="portfolio" id="έργα">
	<div class="wrap portfolio__head">
		<div>
			<h2>Επιλεγμένα έργα</h2>
			<p>
				Μια μικρή επιλογή από χώρους που έχουμε ολοκληρώσει — από ξενοδοχεία και γραφεία μέχρι δημόσια κτίρια.
			</p>
		</div>
	</div>

	<div class="wrap portfolio__grid">
		{
			projects.map((project) => (
				<figure class:list={['shot', `shot--${project.span}`]}>
					<img src={project.image} alt={project.alt} width="1200" height="900" loading="lazy" />
					<figcaption>
						<span>{project.tag}</span>
						<strong>{project.title}</strong>
					</figcaption>
				</figure>
			))
		}
	</div>
</section>

<style>
	.portfolio {
		padding-block: var(--space-xl);
		background: var(--paper);
	}

	.portfolio__head {
		display: grid;
		gap: 1rem;
		max-width: 40rem;
		margin-bottom: var(--space-lg);
	}

	.portfolio__head h2 {
		font-size: clamp(1.9rem, 4vw, 2.8rem);
	}

	.portfolio__head p {
		color: var(--steel);
	}

	.portfolio__grid {
		display: grid;
		gap: 0.85rem;
	}

	.shot {
		margin: 0;
		position: relative;
		overflow: clip;
		background: var(--aegean-deep);
		min-height: 16rem;
	}

	.shot img {
		width: 100%;
		height: 100%;
		min-height: 16rem;
		object-fit: cover;
		transition: transform 700ms var(--ease), filter 700ms var(--ease);
	}

	.shot::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 45%, rgba(18, 21, 19, 0.78) 100%);
		pointer-events: none;
	}

	.shot figcaption {
		position: absolute;
		left: 1.1rem;
		right: 1.1rem;
		bottom: 1.1rem;
		z-index: 1;
		display: grid;
		gap: 0.25rem;
		color: var(--paper);
	}

	.shot figcaption span {
		font-size: 0.82rem;
		opacity: 0.78;
	}

	.shot figcaption strong {
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 550;
		letter-spacing: -0.02em;
	}

	.shot:hover img {
		transform: scale(1.04);
		filter: saturate(1.05);
	}

	@media (min-width: 780px) {
		.portfolio__grid {
			grid-template-columns: repeat(12, 1fr);
			grid-auto-rows: 12rem;
			gap: 1rem;
		}

		.shot--wide {
			grid-column: span 7;
			grid-row: span 2;
		}

		.shot--tall {
			grid-column: span 5;
			grid-row: span 3;
		}

		.shot--normal {
			grid-column: span 5;
			grid-row: span 2;
		}

		.shot img,
		.shot {
			min-height: 100%;
			height: 100%;
		}
	}
</style>
